# OCI config profile to use from ~/.oci/config.
OCI_PROFILE=DEFAULT

# Where backup snapshots should be written. Relative paths are resolved from this file's directory.
OUTPUT_DIR=backups

# Enter comma-separated email addresses when backing up more than one person.
# The script checks both tag formats:
#   oracleidentitycloudservice/<email>
#   <email>
# Example:
# OWNER_EMAILS=owner.one@example.com,owner.two@example.com
OWNER_EMAILS=owner.one@example.com,owner.two@example.com
